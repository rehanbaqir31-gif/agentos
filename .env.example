# Reserved for local development. Never place real credentials in this file.
# SQLite remains the default; either path setting is optional.
# AGENTOS_DATABASE_DRIVER=sqlite
# AGENTOS_SQLITE_DATA_DIR=./.agentos

# Optional PostgreSQL server mode. Keep the URL in a secret store for shared deployments.
# AGENTOS_DATABASE_DRIVER=postgresql
# AGENTOS_DATABASE_URL=postgresql://agentos:password@127.0.0.1:5432/agentos
# AGENTOS_DATABASE_POOL_MAX=10
# AGENTOS_DATABASE_SSL=disable

# Optional provider credential environment variables. Use placeholders only here;
# keep actual values in the host environment or a secret manager.
# OPENAI_API_KEY=replace-me
# ANTHROPIC_API_KEY=replace-me
# GOOGLE_API_KEY=replace-me
# OLLAMA_API_KEY=replace-me
# AGENTOS_MODEL_API_KEY=replace-me

# PostgreSQL integration tests use their own isolated schema.
# AGENTOS_POSTGRES_TEST_URL=postgresql://agentos_test:password@127.0.0.1:5432/agentos_test
